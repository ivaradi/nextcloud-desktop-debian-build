+//-----------------------------------------------------------------------------
+
+#include <QJsonValue>
+
+//-----------------------------------------------------------------------------
+
+#if QT_VERSION<QT_VERSION_CHECK(6, 8, 0)
+inline bool operator==(const QString &lhs, const QJsonValue &rhs)
+{
+    return lhs == rhs.toString();
+}
+
+inline bool operator==(const QJsonValue &lhs, const QString &rhs)
+{
+    return lhs.toString() == rhs;
+}
+
+inline bool operator!=(const QString &lhs, const QJsonValue &rhs)
+{
+    return lhs != rhs.toString();
+}
+
+inline bool operator!=(const QJsonValue &lhs, const QString &rhs)
+{
+    return lhs.toString() != rhs;
+}
+
+// QJsonValueRef is a non-const reference to a QJsonValue inside QJsonObject/QJsonArray
+// It can be implicitly converted to QJsonValue, but we need explicit operators
+// to avoid ambiguity when comparing with QString
+inline bool operator==(const QString &lhs, const QJsonValueRef &rhs)
+{
+    return lhs == rhs.toString();
+}
+
+inline bool operator==(const QJsonValueRef &lhs, const QString &rhs)
+{
+    return lhs.toString() == rhs;
+}
+
+inline bool operator!=(const QString &lhs, const QJsonValueRef &rhs)
+{
+    return lhs != rhs.toString();
+}
+
+inline bool operator!=(const QJsonValueRef &lhs, const QString &rhs)
+{
+    return lhs.toString() != rhs;
+}
+#endif
+
+//-----------------------------------------------------------------------------
+
+#endif // QT_CORE_LIB
