+//-----------------------------------------------------------------------------
+
+#include <QQmlComponent>
+#include <QQmlEngine>
+#include <QUrl>
+
+//-----------------------------------------------------------------------------
+
+#if QT_VERSION<QT_VERSION_CHECK(6, 5, 0)
+namespace {
+inline QUrl qmlComponentUrlFromUri(const QString &uri, const QString &typeName)
+{
+    // Convert uri like "com.nextcloud.desktopclient.search" to qrc path
+    // like "qrc:/qt/qml/com/nextcloud/desktopclient/search/SearchWindow.qml"
+    auto path = uri;
+    path.replace(QLatin1Char('.'), QLatin1Char('/'));
+    return QUrl(QStringLiteral("qrc:/qt/qml/") + path + u'/' + typeName + QStringLiteral(".qml"));
+}
+}
+
+inline QQmlComponent *QmlComponentFromUri(QQmlEngine *engine, const QString &uri, const QString &typeName)
+{
+    return new QQmlComponent(engine, qmlComponentUrlFromUri(uri, typeName));
+}
+#else
+inline QQmlComponent *QmlComponentFromUri(QQmlEngine *engine, const QString &uri, const QString &typeName)
+{
+    return new QQmlComponent(engine, uri, typeName);
+}
+#endif
+
+//-----------------------------------------------------------------------------
+
+#endif // QT_QML_LIB
